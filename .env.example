# ============================================================
# .env.example — BlyssApp environment variables
# Copy to backend/.env.dev (dev) or backend/.env.prod (prod)
# and fill in real values. NEVER commit real secrets.
# ============================================================

# ── Backend ──────────────────────────────────────────────────
#
# DATABASE_URL — deux formats Supabase :
#   Direct (IPv6 seulement sur free plan) :
#     postgresql://postgres:[pwd]@db.[ref].supabase.co:5432/postgres
#   Pooler session mode (IPv4, recommandé — activer dans Supabase dashboard) :
#     postgresql://postgres.[ref]:[pwd]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
#   ⚠️  Ne pas utiliser le pooler transaction (port 6543) — incompatible avec les transactions pg
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Token Supabase Management API — pour scripts/db.mjs (migrations, seed)
# Générer : https://supabase.com/dashboard/account/tokens
# En local, supabase login suffit (keychain macOS) — cette var n'est obligatoire qu'en CI
SUPABASE_ACCESS_TOKEN=[sbp_...]
JWT_SECRET=[min-32-chars — generate: openssl rand -base64 48]
STRIPE_SECRET_KEY=sk_test_[PLACEHOLDER]
STRIPE_WEBHOOK_SECRET=whsec_[PLACEHOLDER]
REVENUECAT_WEBHOOK_SECRET=[PLACEHOLDER]
# Optionnel — secret v1 API key RevenueCat (Project Settings → API keys → secret key,
# PAS la clé publique SDK). Utilisée uniquement pour /api/pro/subscription/sync,
# un filet de secours qui vérifie l'état RevenueCat en direct si le webhook est en retard.
# Sans cette clé, l'endpoint répond simplement "reconciled: false" sans planter.
REVENUECAT_SECRET_API_KEY=[PLACEHOLDER]
# Optionnel — id du projet RevenueCat (dashboard → Project settings, ou `rc projects list`).
# Sert uniquement à vérifier que les identifiants produits du catalogue de prix
# (lib/subscription-catalog.ts) existent toujours côté RevenueCat. Aucun prix n'est
# récupéré (RC ne les expose pas via l'API). Sans cet id, la vérif est simplement ignorée.
REVENUECAT_PROJECT_ID=proj5e4ba3d1

# OBLIGATOIRE en prod — comma-separated allowed origins
# No fallback in production (server will warn and allow only localhost if missing)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

NODE_ENV=development
PORT=3001

# ── Stockage médias (photos profil/bannière/galerie/chat) ─────
# STORAGE_DRIVER absent ou "local" → écrit sur backend/uploads/ (comportement historique).
# STORAGE_DRIVER=r2 → écrit sur Cloudflare R2 (voir étude "Fondations de données").
# Les 4 variables R2_* ci-dessous ne sont lues que si STORAGE_DRIVER=r2.
STORAGE_DRIVER=local
# Cloudflare dashboard → R2 → (visible dans la sidebar du compte)
R2_ACCOUNT_ID=[PLACEHOLDER]
# R2 → Manage API Tokens → Create API Token → "Object Read & Write", scopé au bucket
R2_ACCESS_KEY_ID=[PLACEHOLDER]
R2_SECRET_ACCESS_KEY=[PLACEHOLDER]
# Nom du bucket — un par environnement (ex. blyss-media-dev / -staging / -prod)
R2_BUCKET_NAME=[PLACEHOLDER]
# Obligatoire si le bucket a été créé avec une jurisdiction restreinte (notre cas :
# EU, pour le RGPD) — sinon l'API renvoie "NoSuchBucket" même avec le bon nom.
# Laisser vide seulement si le bucket est en jurisdiction par défaut.
R2_JURISDICTION=eu
# URL publique du bucket — sous-domaine r2.dev (activé dans les settings du bucket)
# ou domaine personnalisé en prod. Sans slash final.
R2_PUBLIC_URL=[PLACEHOLDER — ex. https://pub-xxxxxxxx.r2.dev]

# URL du frontend — utilisée pour les liens reset password
FRONTEND_URL=http://localhost:5173
# URL publique de l'app — incluse dans le lien de l'email de reset
# En prod : https://app.blyssapp.fr
APP_URL=http://localhost:8080

# ── Email (réinitialisation mot de passe) ────────────────────
# Resend : https://resend.com — créer un compte gratuit, vérifier un domaine
# Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_[PLACEHOLDER]
# Expéditeur — doit être un domaine vérifié dans Resend
EMAIL_FROM=Blyss <noreply@blyssapp.fr>

# ── Web Push / VAPID ──────────────────────────────────────────
# Générer : cd backend && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=[PLACEHOLDER]
VAPID_PRIVATE_KEY=[PLACEHOLDER]
VAPID_EMAIL=contact@blyssapp.fr

# ── APNs / Live Activity (iOS) ─────────────────────────────────
# Apple Developer → Certificates, IDs & Profiles → Keys → clé APNs (.p8)
APNS_KEY_ID=[PLACEHOLDER]
APNS_TEAM_ID=[PLACEHOLDER]
# Fichier .p8 stocké hors du repo (jamais committé) : backend/secrets/
APNS_PRIVATE_KEY_PATH=backend/secrets/AuthKey_XXXXXXXXXX.p8
APNS_TOPIC=blyss.app
APNS_ENVIRONMENT=sandbox

# ── Monitoring — optionnel ────────────────────────────────────
# Sentry backend (create project at sentry.io → Node.js)
SENTRY_DSN=[PLACEHOLDER — e.g. https://xxx@oyyy.ingest.sentry.io/zzz]
SENTRY_ENVIRONMENT=development

# Alert webhook (Slack or Discord incoming webhook URL)
ALERT_WEBHOOK_URL=[PLACEHOLDER — https://hooks.slack.com/... or https://discord.com/api/webhooks/...]

# ── Frontend (Vite) ──────────────────────────────────────────
# URL de l'API backend (sans /api, sans slash final)
VITE_API_URL=http://localhost:3001

# Sentry frontend (same Sentry project, DSN is public — different from backend DSN)
VITE_SENTRY_DSN=[PLACEHOLDER — same sentry project, public DSN]
VITE_SENTRY_ENVIRONMENT=development

# ── Playwright E2E ───────────────────────────────────────────
BASE_URL=http://localhost:8080
API_URL=http://localhost:3001
TEST_ADMIN_EMAIL=admin@test.fr
TEST_ADMIN_PASSWORD=[PLACEHOLDER]

# ── Moteur de disponibilités (chantier 4) ────────────────────
# Kill-switch : "true" force TOUTES les pros sur le modèle slots précréés
# (getAvailability lit les slots), quel que soit users.uses_availability_engine.
# Laisser vide en fonctionnement normal.
AVAILABILITY_ENGINE_FORCE_OFF=
